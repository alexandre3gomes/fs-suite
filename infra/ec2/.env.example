# FS Suite — EC2 Environment Variables
#
# Copy this file, fill in the values, and pass to setup.sh:
#   cp .env.example .env
#   scp .env origin.pem origin-key.pem fs-suite:~/
#   ssh fs-suite './setup.sh'
#
# JWT keys: paste the full PEM content between double quotes.
# The setup script converts multiline PEM to escaped format automatically.
# Alternatively, provide them pre-escaped on a single line.

# ── External databases ──
DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require
REDIS_URL=rediss://default:pass@host:6379

# ── Google OAuth ──
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxx

# ── JWT RS256 keypair ──
# Auto-generated by setup.sh — do not provide manually.
# Regenerating keys only invalidates existing sessions (users re-login).

# ── Encryption ──
# Placeholder — replace with a real 32-byte hex key:
#   openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ── Admin metrics endpoint ──
# Header-token auth for GET /v1/admin/metrics, called by the daily
# metrics-digest GitHub Actions workflow. Must match the
# ADMIN_METRICS_TOKEN GitHub Secret exactly.
# Generate with: openssl rand -hex 32
ADMIN_METRICS_TOKEN=replace-with-64-char-hex-token

# ── Sentry (optional) ──
SENTRY_DSN=

# ── AI providers (optional) ──
GEMINI_API_KEY=
GROQ_API_KEY=

# ── Cloudflare R2 (optional) ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ── Email (Resend) ──
# Used by the feedback feature: admin notifications on new feedback and replies
# to users (operational/transactional — no marketing-consent gate). Users also
# keep a marketingEmailConsent opt-in + live one-click unsubscribe. The sender
# domain (fs-suite.com) must be verified in Resend (DKIM/SPF).
RESEND_API_KEY=re_xxxx
# Public base URL of THIS API — used to build one-click unsubscribe links.
# Must be the externally reachable origin (not localhost) in production.
API_PUBLIC_URL=https://api.fs-suite.com
# Optional sender/reply-to overrides. Sender must be on the verified domain.
# EMAIL_FROM=FS Suite <novidades@fs-suite.com>
# EMAIL_REPLY_TO=alexandre@fs-suite.com
# Feedback sender (optional — these are the defaults):
# FEEDBACK_EMAIL_FROM=FS Suite <feedback@fs-suite.com>
# FEEDBACK_EMAIL_REPLY_TO=feedback@fs-suite.com

# ── Supabase ──
# The API no longer uses Supabase at runtime (the communications screenshot
# storage was removed with the broadcast feature). These are kept because the
# db-backup workflow uploads DB dumps to Supabase Storage, and for future use.
#
# SUPABASE_URL: public project URL (NOT secret) — Settings → API → "Project URL".
SUPABASE_URL=https://kottmfuncqyzwtweoquw.supabase.co
# SUPABASE_SERVICE_ROLE_KEY: the server-side full-access key (bypasses RLS).
# On the new Supabase key system this is the "secret key" (sb_secret_…) from
# Settings → API Keys → Secret key. (Legacy projects: the service_role JWT.)
# Treat as a password — never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudflare Origin Certificate ──
# These are separate files (not env vars). Place them alongside .env:
#   origin.pem       — Origin Certificate (PEM)
#   origin-key.pem   — Private Key (PEM)
#
# Generate at: Cloudflare > SSL/TLS > Origin Server > Create Certificate
#   Hostnames: api.fs-suite.com
#   Validity: 15 years
#   Key format: PEM
