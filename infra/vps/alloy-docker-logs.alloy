// Ship the API and nginx container logs to Grafana Cloud Loki.
//
// The Grafana-generated config collects node_exporter metrics and the systemd
// journal. The application's logs are in neither: NestJS logs through pino to
// stdout, which Docker captures with the json-file driver, so nothing reaches
// Loki. Since json-file also rotates (20 MB x 5, see docker-compose.yml) and
// lives inside the container, a deploy discards whatever was there — which is
// the opposite of what logs are for.
//
// This appends to Grafana's own config rather than replacing it, and forwards
// into the loki.write receiver it already declares, so the credential stays in
// one place.
//
// Requires the alloy user in the docker group:
//   sudo usermod -aG docker alloy && sudo systemctl restart alloy

discovery.docker "containers" {
	host = "unix:///var/run/docker.sock"
}

// Keep the container name as a label and drop Docker's leading slash, so
// queries read {container="fs-suite-api-1"} rather than "/fs-suite-api-1".
discovery.relabel "containers" {
	targets = discovery.docker.containers.targets

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container"
	}

	rule {
		source_labels = ["__meta_docker_container_log_stream"]
		target_label  = "stream"
	}
}

loki.source.docker "containers" {
	host       = "unix:///var/run/docker.sock"
	targets    = discovery.relabel.containers.output
	labels     = {job = "docker", host = constants.hostname}
	forward_to = [loki.process.containers.receiver]
}

loki.process "containers" {
	// Lift pino's level and msg into extracted fields. Grafana Cloud derives
	// detected_level from the payload on its own, so nothing here maps the
	// numeric levels to words — an earlier version did that with a template
	// and it was the wrong kind of clever: pino emits `"level":30` as a JSON
	// number, the template compared it against a string, and a stage that
	// errors takes the whole line with it.
	stage.json {
		expressions = {
			level = "level",
			msg   = "msg",
		}
	}

	forward_to = [loki.write.grafana_cloud_loki.receiver]
}
