# Application
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL="postgresql://fssuite:fssuite_dev@localhost:5432/fssuite"

# Redis
REDIS_URL="redis://:redis_dev@localhost:6379"

# Google OAuth — create credentials at https://console.cloud.google.com/apis/credentials
# 1. Create OAuth 2.0 Client ID (Web application)
# 2. Add authorized redirect URI: http://localhost:3001/v1/auth/google/callback
# 3. Configure OAuth consent screen (add your email as test user)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/v1/auth/google/callback

# JWT — RS256 keypair
# Generate with: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nreplace-with-actual-key\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nreplace-with-actual-key\n-----END PUBLIC KEY-----"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# AES-256-GCM key for OAuthAccount token encryption (32 bytes hex)
ENCRYPTION_KEY=replace-with-32-byte-hex-key

# Header-token auth for GET /v1/admin/metrics (daily metrics-digest workflow).
# Generate with: openssl rand -hex 32
ADMIN_METRICS_TOKEN=

# Web app origin (CORS). Expo web dev server defaults to 8081.
WEB_ORIGIN=http://localhost:8081

# Logging
LOG_LEVEL=debug

# AI Validation — free tier provider keys (optional, enables AI flight plan review)
# Gemini: https://aistudio.google.com/apikey
# Groq: https://console.groq.com/keys
GEMINI_API_KEY=
GROQ_API_KEY=

# OpenWeatherMap — precipitation tile proxy (free tier: https://openweathermap.org/api)
OWM_API_KEY=

# Sentry
SENTRY_DSN=
SENTRY_RELEASE=dev
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_AUTH_TOKEN=

# AVWX — optional enriched METAR decoding (https://avwx.rest)
AVWX_TOKEN=

# Object storage — chart PDF cache + feedback attachments (under feedback/).
# LOCAL DEV: the bundled MinIO container (docker compose up) is S3-compatible;
# the values below point at it so charts and feedback attachments work locally
# without touching real Cloudflare R2. Buckets are auto-created by minio-setup.
R2_ENDPOINT=http://localhost:9000
R2_ACCESS_KEY_ID=fssuite
R2_SECRET_ACCESS_KEY=fssuite_dev_secret
R2_BUCKET_NAME=fs-suite-charts
# PROD: leave R2_ENDPOINT unset and use real Cloudflare R2 instead:
#   R2_ENDPOINT=                       (unset → uses https://<account>.r2.cloudflarestorage.com)
#   R2_ACCOUNT_ID=<cloudflare account id>
#   R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY = R2 API token scoped to the bucket

# Resend — transactional email. Used by the feedback feature (admin
# notifications + replies to users). Users also keep a marketingEmailConsent
# opt-in + one-click unsubscribe for any future marketing email.
# NOTE: outside production the API does NOT send — it captures every email into a
# dev inbox at http://localhost:3001/v1/dev/emails (no key needed to preview).
# Set MAIL_FORCE_SEND=true (with a key) to actually send from a non-prod env.
RESEND_API_KEY=
# MAIL_FORCE_SEND=true
# EMAIL_FROM=FS Suite <novidades@fs-suite.com>
# EMAIL_REPLY_TO=alexandre@fs-suite.com
# Feedback sender (optional — these are the defaults):
# FEEDBACK_EMAIL_FROM=FS Suite <feedback@fs-suite.com>
# FEEDBACK_EMAIL_REPLY_TO=feedback@fs-suite.com
# Email signature footer (optional). The reply is signed with the replying
# admin's own name (from their User record); the TITLE is resolved by email:
# the founder account gets FOUNDER_TITLE, every other admin gets ADMIN_TITLE.
# Logo + GitHub are shared. Override any field without a code change:
# Images are served from the sending domain (frontend public/email/) so they
# align with fs-suite.com for deliverability. Defaults:
# FEEDBACK_SIGNATURE_LOGO_URL=https://fs-suite.com/email/fs-suite-logo.png
# FEEDBACK_SIGNATURE_GITHUB_ICON_URL=https://fs-suite.com/email/github-mark.png
# FEEDBACK_SIGNATURE_GITHUB=https://github.com/alexandre3gomes/fs-suite/
# FEEDBACK_SIGNATURE_SITE_URL=https://fs-suite.com   # logo links here
# FEEDBACK_SIGNATURE_FOUNDER_EMAIL=alexandre3gomes@gmail.com
# FEEDBACK_SIGNATURE_FOUNDER_TITLE=Founder & Lead Engineer | FS Suite
# FEEDBACK_SIGNATURE_ADMIN_TITLE=Administration team | FS Suite

# Resend marketing Audience (broadcasts / new-feature announcements). Users are
# mirrored into the audience: created on signup, unsubscribed flag tracks
# marketingEmailConsent, removed on account deletion. The DB is the source of
# truth; the webhook reflects audience-side unsubscribes/complaints back.
# Sync is gated to production (set RESEND_AUDIENCE_FORCE=true to test in dev —
# it will hit the real audience, so use a throwaway one).
# RESEND_AUDIENCE_ID=<audience id from the Resend dashboard>
# RESEND_WEBHOOK_SECRET=whsec_xxx   # Svix signing secret for the webhook
# RESEND_AUDIENCE_FORCE=true
