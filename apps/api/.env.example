# Application
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL="postgresql://fssuite:fssuite_dev@localhost:5432/fssuite"

# Redis
REDIS_URL="redis://:redis_dev@localhost:6379"

# Google OAuth — create credentials at https://console.cloud.google.com/apis/credentials
# 1. Create OAuth 2.0 Client ID (Web application)
# 2. Add authorized redirect URI: http://localhost:3001/v1/auth/google/callback
# 3. Configure OAuth consent screen (add your email as test user)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/v1/auth/google/callback

# JWT — RS256 keypair
# Generate with: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nreplace-with-actual-key\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nreplace-with-actual-key\n-----END PUBLIC KEY-----"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# AES-256-GCM key for OAuthAccount token encryption (32 bytes hex)
ENCRYPTION_KEY=replace-with-32-byte-hex-key

# Header-token auth for GET /v1/admin/metrics (daily metrics-digest workflow).
# Generate with: openssl rand -hex 32
ADMIN_METRICS_TOKEN=

# Web app origin (CORS). Expo web dev server defaults to 8081.
WEB_ORIGIN=http://localhost:8081

# Logging
LOG_LEVEL=debug

# AI Validation — free tier provider keys (optional, enables AI flight plan review)
# Gemini: https://aistudio.google.com/apikey
# Groq: https://console.groq.com/keys
GEMINI_API_KEY=
GROQ_API_KEY=

# OpenWeatherMap — precipitation tile proxy (free tier: https://openweathermap.org/api)
OWM_API_KEY=

# Sentry
SENTRY_DSN=
SENTRY_RELEASE=dev
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_AUTH_TOKEN=

# AVWX — optional enriched METAR decoding (https://avwx.rest)
AVWX_TOKEN=

# Cloudflare R2 — chart PDF cache (optional, skip for local dev)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=fs-suite-charts

# Resend — transactional/marketing email. Configured and reserved for FUTURE
# user communications (users keep a marketingEmailConsent opt-in + one-click
# unsubscribe). No email is sent today; leave blank for local dev. When the
# feature is built, set the API key and (optionally) override the sender.
RESEND_API_KEY=
# EMAIL_FROM=FS Suite <novidades@fs-suite.com>
# EMAIL_REPLY_TO=alexandre@fs-suite.com
