# Application
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL="postgresql://fssuite:fssuite_dev@localhost:5432/fssuite"

# Redis
REDIS_URL="redis://:redis_dev@localhost:6379"

# Google OAuth — create credentials at https://console.cloud.google.com/apis/credentials
# 1. Create OAuth 2.0 Client ID (Web application)
# 2. Add authorized redirect URI: http://localhost:3001/v1/auth/google/callback
# 3. Configure OAuth consent screen (add your email as test user)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/v1/auth/google/callback

# VATSIM OAuth — register at https://auth.vatsim.net/
# 1. Create an organization and OAuth client
# 2. Add redirect URI: http://localhost:3001/v1/auth/vatsim/callback
# 3. Request scopes: full_name, email
VATSIM_CLIENT_ID=your-vatsim-client-id
VATSIM_CLIENT_SECRET=your-vatsim-client-secret
VATSIM_CALLBACK_URL=http://localhost:3001/v1/auth/vatsim/callback
VATSIM_OAUTH_BASE_URL=https://auth.vatsim.net

# JWT — RS256 keypair
# Generate with: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nreplace-with-actual-key\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nreplace-with-actual-key\n-----END PUBLIC KEY-----"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# AES-256-GCM key for OAuthAccount token encryption (32 bytes hex)
ENCRYPTION_KEY=replace-with-32-byte-hex-key

# Web app origin (CORS)
WEB_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=debug

# Sentry
SENTRY_DSN=
SENTRY_RELEASE=dev
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_AUTH_TOKEN=
