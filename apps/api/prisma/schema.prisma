// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String
  avatarUrl String?   @map("avatar_url")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at") // soft delete for LGPD

  oauthAccounts          OAuthAccount[]
  sessions               Session[]
  flightPlans            FlightPlan[]
  aircraftProfiles       AircraftProfile[]
  activityLogs           ActivityLog[]
  integrationConnections IntegrationConnection[]

  @@map("users")
}

model OAuthAccount {
  id                String    @id @default(cuid())
  provider          String // "google"
  providerAccountId String    @map("provider_account_id")
  accessToken       String?   @map("access_token") // encrypted at rest (AES-256-GCM)
  refreshToken      String?   @map("refresh_token") // encrypted at rest (AES-256-GCM)
  expiresAt         DateTime? @map("expires_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("oauth_accounts")
}

model Session {
  id               String   @id @default(cuid())
  refreshTokenHash String   @unique @map("refresh_token_hash") // bcrypt hash of the raw refresh token JWT
  expiresAt        DateTime @map("expires_at")
  createdAt        DateTime @default(now()) @map("created_at")
  lastUsedAt       DateTime @default(now()) @map("last_used_at")
  userAgent        String?  @map("user_agent")
  ipAddress        String?  @map("ip_address") // disclosed in privacy policy; LGPD compliant

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model AircraftProfile {
  id               String   @id @default(cuid())
  name             String
  icaoType         String?  @map("icao_type")
  manufacturer     String?
  model            String?
  emptyWeightKg    Float?   @map("empty_weight_kg")
  mtowKg           Float?   @map("mtow_kg")
  fuelCapacityL    Float?   @map("fuel_capacity_l")
  fuelBurnLph      Float?   @map("fuel_burn_lph")
  cruiseSpeedKts   Int?     @map("cruise_speed_kts")
  source           String?
  dataCompleteness String   @default("skeleton") @map("data_completeness")
  isTemplate       Boolean  @default(false) @map("is_template")
  clonedFromId     String?  @map("cloned_from_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  userId   String?                  @map("user_id")
  user     User?                    @relation(fields: [userId], references: [id])
  stations AircraftProfileStation[]

  @@index([icaoType, isTemplate])
  @@map("aircraft_profiles")
}

model AircraftProfileStation {
  id        String @id @default(cuid())
  profileId String @map("profile_id")
  stationId String @map("station_id")
  labelKey  String @map("label_key")
  defaultKg Float  @map("default_kg")
  maxKg     Float  @map("max_kg")
  arm       Float

  profile AircraftProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("aircraft_profile_stations")
}

model Airport {
  icao      String  @id
  iata      String?
  name      String
  city      String?
  country   String?
  latitude  Float
  longitude Float
  elevation Int? // feet
  type      String? // large_airport, medium_airport, small_airport, heliport, seaplane_base, closed
  raw       Json? // full source record (OurAirports) for future enrichment

  runways       Runway[]
  frequencies   Frequency[]
  chartOverlays AerodromeChartOverlay[]

  @@index([latitude, longitude])
  @@map("airports")
}

// On-demand cache of an aerodrome chart rendered as a georeferenced map overlay.
// Bounds are derived automatically from Airport (ARP) and Runway data; the raster
// is produced once per (sourceUrl, AIRAC cycle) and stored in R2. See
// docs/aerodrome-chart-overlay.md.
model AerodromeChartOverlay {
  id                 String   @id @default(cuid())
  icao               String
  chartType          String   @map("chart_type") // VAC (PDC in future)
  chartName          String   @map("chart_name")
  sourceUrl          String   @map("source_url")
  sourceAuthority    String   @map("source_authority")
  pageIndex          Int      @default(0) @map("page_index")
  imageKey           String   @map("image_key") // R2 object key
  imageContentType   String   @default("image/png") @map("image_content_type")
  imageWidth         Int      @map("image_width")
  imageHeight        Int      @map("image_height")
  boundsSouth        Float    @map("bounds_south")
  boundsWest         Float    @map("bounds_west")
  boundsNorth        Float    @map("bounds_north")
  boundsEast         Float    @map("bounds_east")
  rotationDeg        Float    @default(0) @map("rotation_deg")
  opacityDefault     Float    @default(0.7) @map("opacity_default")
  preparedAiracCycle String   @map("prepared_airac_cycle") // cycle in which this cache row was produced
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  airport Airport @relation(fields: [icao], references: [icao])

  @@unique([sourceUrl, preparedAiracCycle])
  @@index([icao])
  @@map("aerodrome_chart_overlays")
}

model Runway {
  id            String  @id @default(cuid())
  airportIcao   String  @map("airport_icao")
  ident         String // e.g. "09L/27R"
  lengthFt      Int?    @map("length_ft")
  widthFt       Int?    @map("width_ft")
  surfaceType   String? @map("surface_type") // e.g. "ASP", "GRS", "CON"
  leIdent       String? @map("le_ident") // low-end identifier e.g. "09L"
  leHeadingDeg  Float?  @map("le_heading_deg")
  leElevationFt Int?    @map("le_elevation_ft")
  heIdent       String? @map("he_ident") // high-end identifier e.g. "27R"
  heHeadingDeg  Float?  @map("he_heading_deg")
  heElevationFt Int?    @map("he_elevation_ft")
  closed        Boolean @default(false)

  airport Airport @relation(fields: [airportIcao], references: [icao], onDelete: Cascade)

  @@index([airportIcao])
  @@map("runways")
}

model Frequency {
  id           String @id @default(cuid())
  airportIcao  String @map("airport_icao")
  type         String // TWR, GND, APP, ATIS, AFIS, CTAF, RDO, DEP, CLD, OPS, etc.
  description  String
  frequencyMhz Float  @map("frequency_mhz")

  airport Airport @relation(fields: [airportIcao], references: [icao], onDelete: Cascade)

  @@index([airportIcao])
  @@map("frequencies")
}

// --- Flight Plan ---
// Schema is organized into OPERATIONAL CORE (auditable plan data)
// and ENRICHMENTS (briefing, visual aids, computed data).

model FlightPlan {
  id          String      @id @default(cuid())
  userId      String      @map("user_id")
  status      PlanStatus  @default(DRAFT)
  flightRules FlightRules @default(VFR) @map("flight_rules")

  // ── OPERATIONAL CORE ─────────────────────────────────────
  // These fields define the flight plan itself. They must be
  // stable, auditable, and sufficient to reproduce the plan.

  // Aerodromes
  originIcao        String  @map("origin_icao")
  originName        String  @map("origin_name")
  originElevationFt Int?    @map("origin_elevation_ft")
  destinationIcao        String  @map("destination_icao")
  destinationName        String  @map("destination_name")
  destinationElevationFt Int?    @map("destination_elevation_ft")
  destinationTpaFt       Int?    @map("destination_tpa_ft")
  destinationTpaSource   String? @map("destination_tpa_source")
  altitudeChanges        Json?   @map("altitude_changes")
  alternateIcao        String? @map("alternate_icao")
  alternateName        String? @map("alternate_name")
  alternateElevationFt Int?    @map("alternate_elevation_ft")

  // Alternate route — destination → alternate segment.
  // Stored separately from the main A→B route because ICAO Item 15
  // only carries the main route; the alternate leg is operational
  // planning data. REA Obrig compliance is mandatory for VFR when the
  // segment crosses corridors (ICA 100-12). See FlightPlanRoute.role.
  alternateRouteText            String? @map("alternate_route_text")
  alternateTotalDistanceNm      Float?  @map("alternate_total_distance_nm")
  alternatePlannedAltitude      Int?    @map("alternate_planned_altitude")

  // Aircraft identification
  aircraftType     String? @map("aircraft_type")
  aircraftName     String? @map("aircraft_name")
  callsign         String?
  registration     String?

  // Aircraft performance
  emptyWeightKg    Float?  @map("empty_weight_kg")
  takeoffWeightKg  Float?  @map("takeoff_weight_kg")
  mtowKg           Float?  @map("mtow_kg")
  fuelCapacityL    Float?  @map("fuel_capacity_l")
  fuelBurnLph      Float?  @map("fuel_burn_lph")
  aircraftStations Json?   @map("aircraft_stations")
  cruiseSpeedKts   Int?    @map("cruise_speed_kts")

  // Equipment (ICAO Item 10)
  equipmentCode    String? @map("equipment_code")
  surveillanceCode String? @map("surveillance_code")

  // Route
  routeText       String? @map("route_text")
  cruiseLevel     String? @map("cruise_level")
  plannedAltitude Int?    @map("planned_altitude")
  totalDistanceNm Float?  @map("total_distance_nm")
  remarks         String?

  // Time
  plannedDepartureUtc DateTime? @map("planned_departure_utc")
  estimatedElapsedMin Int?      @map("estimated_elapsed_min")
  estimatedArrivalUtc DateTime? @map("estimated_arrival_utc")

  // Fuel / endurance
  fuelConsumptionPerHour Float? @map("fuel_consumption_per_hour")
  fuelCurrentTotal       Float? @map("fuel_current_total")
  fuelReserveMinutes     Int?   @map("fuel_reserve_minutes")
  fuelRequiredTotal      Float? @map("fuel_required_total")
  fuelPerWing            Float? @map("fuel_per_wing")
  enduranceMinutes       Int?   @map("endurance_minutes")

  // Supplementary (ICAO Item 19)
  personsOnBoard        Int?    @map("persons_on_board")
  pilotInCommand        String? @map("pilot_in_command")
  aircraftColorMarkings String? @map("aircraft_color_markings")

  // ── ENRICHMENTS ──────────────────────────────────────────
  // Computed, snapshot, or display data. Not part of the
  // formal plan — supports briefing, map, and validation UX.

  // Aerodrome snapshots (weather at save time)
  originRunwayInUse String? @map("origin_runway_in_use")
  originMetarRaw    String? @map("origin_metar_raw")
  destinationRunwayInUse String? @map("destination_runway_in_use")
  destinationMetarRaw    String? @map("destination_metar_raw")
  alternateRunwayInUse String? @map("alternate_runway_in_use")
  alternateMetarRaw    String? @map("alternate_metar_raw")

  // Wind / performance (computed from weather)
  avgWindSpeed     Int? @map("avg_wind_speed")
  avgWindDirection Int? @map("avg_wind_direction")
  groundSpeed      Int? @map("ground_speed")

  // TOC/TOD (computed from performance profile)
  todMinutes    Int?    @map("tod_minutes")
  todDistanceNm Float?  @map("tod_distance_nm")

  // External references
  simbriefOfpId    String? @map("simbrief_ofp_id")

  // Assessment basis (reproducibility)
  weatherBasis String? @map("weather_basis")

  // ── METADATA ─────────────────────────────────────────────

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user             User                    @relation(fields: [userId], references: [id])
  routes           FlightPlanRoute[]
  visualReferences FlightPlanVisualReference[]
  briefingItems    FlightPlanBriefingItem[]

  @@index([userId, deletedAt])
  @@map("flight_plans")
}

model FlightPlanRoute {
  id            String              @id @default(cuid())
  flightPlanId  String              @map("flight_plan_id")
  sequence      Int
  waypointIdent String              @map("waypoint_ident")
  latitude      Float?
  longitude     Float?
  airway        String?
  // Discriminates main A→B route (default) from the alternate
  // leg B→C. Both share this table to reuse the sequence/waypoint
  // shape; queries filter by role.
  role          FlightPlanRouteRole @default(MAIN)

  flightPlan FlightPlan @relation(fields: [flightPlanId], references: [id], onDelete: Cascade)

  @@index([flightPlanId, role, sequence])
  @@map("flight_plan_routes")
}

enum FlightPlanRouteRole {
  MAIN
  ALTERNATE
}

model FlightPlanVisualReference {
  id                  String @id @default(cuid())
  flightPlanId        String @map("flight_plan_id")
  sequence            Int
  name                String
  distanceNm          Float? @map("distance_nm")
  timeMin             Int?   @map("time_min")
  groundSpeedKts      Int?   @map("ground_speed_kts")
  windCorrectionAngle Int?   @map("wind_correction_angle")
  magneticHeading     Int?   @map("magnetic_heading")

  flightPlan FlightPlan @relation(fields: [flightPlanId], references: [id], onDelete: Cascade)

  @@index([flightPlanId, sequence])
  @@map("flight_plan_visual_references")
}

model FlightPlanBriefingItem {
  id           String  @id @default(cuid())
  flightPlanId String  @map("flight_plan_id")
  code         String // machine key e.g. "start_simacars", "pdc_briefing"
  label        String // display label
  checked      Boolean @default(false)
  notes        String?

  flightPlan FlightPlan @relation(fields: [flightPlanId], references: [id], onDelete: Cascade)

  @@index([flightPlanId])
  @@map("flight_plan_briefing_items")
}

model IntegrationConnection {
  id         String   @id @default(cuid())
  service    String // "simbrief"
  externalId String?  @map("external_id") // SimBrief pilot ID (username)
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, service])
  @@map("integration_connections")
}

model ActivityLog {
  id        String   @id @default(cuid())
  action    String // e.g. "flight_plan.created", "auth.login", "simbrief.import"
  metadata  Json? // no PII beyond userId
  createdAt DateTime @default(now()) @map("created_at")

  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@map("activity_logs")
}

enum PlanStatus {
  DRAFT
  COMPLETED
  ARCHIVED
}

enum FlightRules {
  VFR
  IFR
  VFR_IFR
  IFR_VFR
}
